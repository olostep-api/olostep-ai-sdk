{
  "name": "@olostep/ai-sdk",
  "version": "0.1.0",
  "description": "Olostep tools for the Vercel AI SDK: live web search, scraping, crawling and cited answers for AI agents.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ai",
    "ai-sdk",
    "vercel",
    "tools",
    "agents",
    "web-search",
    "web-scraping",
    "crawling",
    "olostep"
  ],
  "homepage": "https://www.olostep.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/olostep-api/olostep-ai-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/olostep-api/olostep-ai-sdk/issues"
  },
  "author": "Olostep <info@olostep.com>",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "olostep": "^1.2.2"
  },
  "peerDependencies": {
    "ai": "^5.0.0 || ^6.0.0 || ^7.0.0",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "ai": "^7.0.0",
    "tsup": "^8.5.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "zod": "^4.0.0"
  }
}
